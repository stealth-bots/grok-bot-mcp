# Grok Bot webhook routine URL (from the routine panel).
GROK_BOT_WEBHOOK_URL=https://example.com/webhook/replace-me

# Sender key from the same routine panel. Sent as Authorization bearer and X-Automation-Key.
GROK_BOT_WEBHOOK_KEY=replace-with-the-routine-sender-key

# Bearer token the bot must send when it POSTs to /api/reply.
# Use a different value from the webhook key and the MCP API keys.
REPLY_SECRET=replace-with-a-long-random-secret

# Comma-separated MCP caller keys. Each entry is name:secret.
# The name is recorded as `caller` on the webhook body. Secrets may contain colons; names may not.
# Example with two callers: claude:secret-one,cursor:secret-two
# Clients send only the secret half (Bearer secret-one). Sending this whole value returns 401.
MCP_API_KEY=cursor:replace-with-a-long-random-secret

# Public origin of this deployment, no trailing slash. reply_url is ${PUBLIC_BASE_URL}/api/reply.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# How long ask_bot waits for the callback, in seconds. Default 25. Maximum 50.
# WAIT_SECONDS=25

# Job TTL in seconds. Default 86400 (24h). Minimum 60.
# JOB_TTL_SECONDS=86400

# Maximum accepted `message` size in UTF-8 bytes. Default 16384.
# MAX_MESSAGE_BYTES=16384

# Webhook POST timeout in milliseconds. Default 8000. One attempt, no retry.
# WEBHOOK_TIMEOUT_MS=8000

# Upstash Redis REST. Required on Vercel and other Node hosts.
# Workers use the D1 binding DB instead of these variables.
# The Vercel KV names KV_REST_API_URL and KV_REST_API_TOKEN are also accepted.
# pnpm dev ignores these and uses an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PORT=3000
