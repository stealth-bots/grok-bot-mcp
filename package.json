{
  "name": "grok-bot-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server that lets external agents talk to a Grok Bot over its webhook.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/dev-server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  }
}
